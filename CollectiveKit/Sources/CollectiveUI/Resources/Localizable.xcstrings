          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows the earlier sessions"
          }
        }
      }
    },
    "subspace changes on GitHub" : {
      "comment" : "VoiceOver name of the action that opens the changes between the installed and the offered subspace version on GitHub (the link at the end of the sentence under the update commands in a tool's settings). subspace is the plugin's name and stays untranslated.",
