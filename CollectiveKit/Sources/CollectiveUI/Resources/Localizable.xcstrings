        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "subspace changes on GitHub"
          }
        }
      }
    },
    "subspace source code on GitHub" : {
      "comment" : "VoiceOver name of the action that opens the plugin's source repository on GitHub (the link at the end of the sentence under a tool card's commands). subspace is the plugin's name and stays untranslated.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "subspace source code on GitHub"
          }
        }
      }
    },
    "The Collective is dormant." : {
      "comment" : "Popover empty state title, shown when no agents are running. Alludes to the Borg Collective in Star Trek; keep the cold, collective-hive tone in translation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Collective is dormant."
          }
        }
      }
    },
    "The Collective Settings" : {
      "comment" : "Title of the settings window, e.g. in the Window menu. \"The Collective\" is the app's name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Collective Settings"
          }
        }
      }
    },
    "Undo" : {
      "comment" : "Button in the row that replaces an item the user just archived; takes the archive back. Keep it short.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undo"
          }
        }
      }
    },
    "What if I don’t see any sessions?" : {
      "comment" : "Link in the footer of the setup window that opens the troubleshooting page.",
      "localizations" : {
