{
  "sourceLanguage" : "en",
  "strings" : {
    "Archive" : {
      "comment" : "Menu item and accessibility action that puts a session away by hand (not delete, not dismiss); it leaves the list and can be undone for a few seconds. Also the label of the finished row's menu item.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive"
          }
        }
      }
    },
    "Archive All Finished" : {
      "comment" : "Context-menu item of a row in the Finished tab: archives every session listed under Finished at once.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive All Finished"
          }
        }
      }
    },
    "Archive Subagent" : {
      "comment" : "Context-menu item and VoiceOver action on a subagent row in a session row's list: puts that one subagent away by hand (not delete, not stop), so it stops counting as working; it can be undone for a few seconds.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive Subagent"
          }
        }
      }
    },
    "Check Again" : {
      "comment" : "Button in the popover's warning block and in the setup window's footer: probes the subspace installation again after the user ran the commands.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check Again"
          }
        }
      }
    },
    "Close" : {
      "comment" : "The popover's reply card (a row's whole last reply, or a subagent's prompt and result, over the list): tooltip and accessibility label of the × button at its top right that closes the card.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close"
          }
        }
      }
    },
    "Step %@" : {
      "comment" : "Accessibility label of the number in front of a command in the setup card's command box (not shown on screen); the number is the command's place in the run.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Step %@"
          }
        }
      }
    },
    "collapsed" : {
      "comment" : "VoiceOver value of the Show/Hide Output button while the commands' output is hidden, and of a session row's subagent toggle line or fold row while its list is closed.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "collapsed"
          }
        }
      }
    },
    "Connect your agents" : {
      "comment" : "Heading of the setup window.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect your agents"
          }
        }
      }
    },
    "Copied" : {
      "comment" : "Label of the Copy button (popover's warning block and setup window) for about a second after it copied the commands; also its accessibility value.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copied"
          }
        }
      }
    },
    "Copy" : {
      "comment" : "Button next to the command box, in the popover's warning block and on the setup window's cards: copies all command lines to the clipboard.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy"
          }
        }
      }
    },
    "Copy %@" : {
      "comment" : "Accessibility label of the Copy button next to a command in the command box, in the popover's warning block and in the setup window. The placeholder is the shell line the button copies, e.g. \"Copy claude plugin install example\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy %@"
          }
        }
      }
    },
    "Copy Path" : {
      "comment" : "Context menu item of a session row in every tab, also a VoiceOver action: copies the session's project folder, quoted for a terminal when needed, e.g. to cd there.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy Path"
          }
        }
      }
    },
    "Copy Resume Command" : {
      "comment" : "Context menu item of a session row in every tab, also a VoiceOver action on the row: copies a shell line (e.g. \"cd <folder> && <tool> --resume <id>\") that continues the session when pasted into a terminal. Absent for tools without one.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy Resume Command"
          }
        }
      }
    },
    "Copy Session ID" : {
      "comment" : "Context menu item of a session row in every tab, also a VoiceOver action on the row: copies the coding tool's ID of the session, e.g. to resume it in a terminal.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy Session ID"
          }
        }
      }
    },
    "Done" : {
      "comment" : "Accessibility label of a finished-command checkmark in front of a command in the setup card's command box (not shown on screen), and the setup window's button that closes it once a tool is connected.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Done"
          }
        }
      }
    },
    "Events stay on this Mac and are deleted after 3 days." : {
      "comment" : "Privacy note in the footer of the setup window.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Events stay on this Mac and are deleted after 3 days."
          }
        }
      }
    },
    "expanded" : {
      "comment" : "VoiceOver value of the Show/Hide Output button while the commands' output is shown, and of a session row's subagent toggle line or fold row while its list is open.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "expanded"
          }
        }
      }
    },
    "Failed" : {
      "comment" : "Accessibility label of a failed-command cross in front of a command in the setup card's command box (not shown on screen).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failed"
          }
        }
      }
    },
    "Hide Output" : {
      "comment" : "Setup window, a tool card after a successful run: link-style button that hides the commands' output again.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide Output"
          }
        }
      }
    },
    "Hides the earlier sessions" : {
      "comment" : "Accessibility hint of the earlier-sessions heading under the subspace warning while its list is open; activating it collapses the list to the heading.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hides the earlier sessions"
          }
        }
      }
    },
    "Install it once for each tool you use." : {
      "comment" : "Setup window head: the sentence after the one that explains subspace, before the link \"Learn more ↗\". \"it\" is subspace, the plugin. It follows the kit's sentence \"The Collective sees your agents through subspace, a small plugin that records what they do and never steers them.\" (CollectiveKit catalog, the same sentence About shows, so it must stay identical there and is not rephrased here); the code fixes this order, so this sentence cannot move before it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install it once for each tool you use."
          }
        }
      }
    },
    "Later" : {
      "comment" : "Button that closes the setup window while no tool is connected yet.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Later"
          }
        }
      }
    },
    "More" : {
      "comment" : "Popover session row: tooltip and accessibility label of the \"⋯\" button that takes the time's place under the pointer and opens the row's menu (Show in Terminal, Copy, Archive).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More"
          }
        }
      }
    },
    "No agents are running. Sessions appear here as soon as one starts." : {
      "comment" : "Popover empty state explanation under the title.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No agents are running. Sessions appear here as soon as one starts."
          }
        }
      }
    },
    "Not run yet" : {
      "comment" : "Accessibility label of a not-yet-run empty circle in front of a command in the setup card's command box (not shown on screen).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not run yet"
          }
        }
      }
    },
    "Or type this in a session:" : {
      "comment" : "Line between the terminal commands and the commands typed inside a running agent session, on a setup card.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or type this in a session:"
          }
        }
      }
    },
    "Quit The Collective" : {
      "comment" : "Plain button at the bottom of the settings window sidebar that quits the app.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quit The Collective"
          }
        }
      }
    },
    "Read Reply" : {
      "comment" : "Accessibility action on a popover row whose last reply (an agent's last answer) is cut short: opens the whole reply in a card over the list and moves VoiceOver there to read it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read Reply"
          }
        }
      }
