        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show Reply"
          }
        }
      }
    },
    "Show Result" : {
      "comment" : "Context menu entry and accessibility action on a subagent row in a popover row: opens a card over the list with the subagent's prompt and its whole result (its final answer).",
