    "%lld done" : {
      "comment" : "Number of a session's subagents that finished normally, after other counts, at any depth. On the subagent toggle line under a session's row in the popover, e.g. \"Subagents 2 working · 1 needs you · 3 done\"; on the fold row in the subagent list, e.g. \"33 done\"; in an idle session's preview footer, e.g. \"14 subagents · 13 done · 1 archived\"; and read by VoiceOver as part of a session row's label, e.g. \"2 subagents working, 14 done\".",
      "localizations" : {
        "en" : {
          "variations" : {
