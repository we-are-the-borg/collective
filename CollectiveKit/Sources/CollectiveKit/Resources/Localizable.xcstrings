{
  "sourceLanguage" : "en",
  "strings" : {
    " · Default" : {
      "comment" : "Settings window, Appearance pane: marker after the scheme family (e.g. \"Catppuccin\") in the list row of the scheme used when the user picked none. Keep the leading space and dot.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · Default"
          }
        }
      }
    },
    " · in use" : {
      "comment" : "Settings window, Appearance pane: marker after the slot's name (\"Light Mode\" or \"Dark Mode\") that macOS shows right now. Keep the leading space and dot.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · in use"
          }
        }
      }
    },
    "%@ can’t be read. Using %@." : {
      "comment" : "Settings window, Appearance pane: notice under a scheme slot whose chosen custom theme file is there but no longer reads as a theme, e.g. \"Embers Light can’t be read. Using Catppuccin Latte.\" The first argument is the custom theme's name as its file writes it (or its file name), never translated; the second the full name of the default scheme shown instead, e.g. \"Catppuccin Latte\", never translated.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ can’t be read. Using %@."
          }
        }
      }
    },
    "%@ is gone. Using %@." : {
      "comment" : "Settings window, Appearance pane: notice under a scheme slot whose chosen custom theme file was deleted or moved, e.g. \"Horizon Dark is gone. Using Catppuccin Macchiato.\" The first argument is the custom theme's name as its file wrote it (or its file stem), never translated; the second the full name of the default scheme shown instead, e.g. \"Catppuccin Macchiato\", never translated.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is gone. Using %@."
          }
        }
      }
    },
    "%@ is not a color" : {
      "comment" : "Settings window, Appearance pane: reason after a custom theme file name in an error row of the Custom section (\"ocean.yaml · <reason>\"); short, lowercase, no period. The argument is the palette key as written in base16/base24 files, e.g. \"base0A\"; keep it as it is. Its value is no #rrggbb color.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is not a color"
          }
        }
      }
    },
    "(default)" : {
      "comment" : "Settings window, pane of one coding tool: marker after the event folder path while the default folder is used.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(default)"
          }
        }
      }
    },
    "%@" : {
      "comment" : "Title of a row in a session row's subagent list in the popover: the kind of subagent as the coding tool names it, e.g. \"Explore\", or its task. The argument is the tool's own word; keep it as it is.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        }
      }
    },
    "%@ · not on this Mac" : {
      "comment" : "Setup window, card of one coding tool, line under the tool name when its command-line program was not found. The argument is the program's name, e.g. \"claude\"; shown in a monospaced font.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · not on this Mac"
          }
        }
      }
    },
    "%@ · user scope" : {
      "comment" : "Setup window, card of one coding tool, detail under the step \"subspace installed\": the installed subspace version, e.g. \"0.4.0\", installed for the whole user account rather than one project.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · user scope"
          }
        }
      }
    },
    "%@ %@" : {
      "comment" : "VoiceOver, row of a session asking a question without options: the question with its label, e.g. \"Mapping, choose one: Which revision?\", then where to answer, e.g. \"Answer in Terminal.\" Keep the order unless your language needs another.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ %@"
          }
        }
      }
    },
    "%@ ago" : {
      "comment" : "Popover, row in the Finished tab, right side: how long ago the session ended, next to its status word (\"done\", \"no clean exit\"). The argument is a duration such as \"2 min\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ago"
          }
        }
      }
    },
    "%@ archived" : {
      "comment" : "Undo row in place of a session or a subagent the user just archived, followed by an Undo button. The argument is the session's project name, or the coding tool's name when the session has no project, e.g. \"collective archived\"; for a subagent, its type or task as the coding tool names it, e.g. \"Explore archived\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ archived"
          }
        }
      }
    },
    "%@ found" : {
      "comment" : "Setup window, card of one coding tool, check step: the tool's command-line program was found. The argument is the tool's name, e.g. \"Claude Code\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ found"
          }
        }
      }
    },
    "%@ has a question for you: %@" : {
      "comment" : "First line of a macOS notification that a subagent asks the user a question. The first argument is the subagent's type, e.g. \"Explore\"; the second the question, e.g. \"Which color do you like?\". The options follow on the next line.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has a question for you: %@"
          }
        }
      }
    },
    "%@ needs your permission: %@" : {
      "comment" : "Body of a macOS notification that a subagent asks the user to allow a tool call. The first argument is the subagent's type, e.g. \"Explore\"; the second the tool's name, e.g. \"Bash\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ needs your permission: %@"
          }
        }
      }
    },
    "%@ needs your permission: %@ · %@" : {
      "comment" : "Body of a macOS notification that a subagent asks the user to allow a tool call. The first argument is the subagent's type, e.g. \"Explore\"; then the tool's name, e.g. \"Bash\", and what the call works on, e.g. a command or file path.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ needs your permission: %@ · %@"
          }
        }
      }
    },
    "%@ Options: %@; %lld %@. %@" : {
      "comment" : "VoiceOver, row of a session asking a question: the question with its label, e.g. \"Mapping, choose one: Which revision?\"; then the agent's options numbered as Terminal numbers them, each followed by its description if it has one, e.g. \"1 Revision 5, Bundled today; 2 Revision 6\"; then the number of the last choice and its name, e.g. \"3\" and \"Other\"; then where to answer, e.g. \"Answer in Terminal.\"",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Options: %@; %lld %@. %@"
          }
        }
      }
    },
    "%@ Options: %@. %@" : {
      "comment" : "VoiceOver, row of a session asking a question whose tool takes no answer of the user's own: the question with its label, e.g. \"Mapping, choose one: Which revision?\"; then the agent's options numbered as Terminal numbers them, each followed by its description if it has one, e.g. \"1 Revision 5, Bundled today; 2 Revision 6\"; then where to answer, e.g. \"Answer in Terminal.\"",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Options: %@. %@"
          }
        }
      }
    },
    "%@ website" : {
      "comment" : "VoiceOver label of the arrow link next to an acknowledged library, font or scheme in the About pane. The argument is its name, e.g. \"GRDB.swift\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ website"
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "VoiceOver: joins two parts of a label, e.g. for one row of the popover a subagent's \"Explore\" and \"Haiku 5.5\", or in the Appearance pane the list's name and how many schemes it shows, \"Dark Mode schemes\" and \"26 schemes\". Keep the comma unless the language separates such lists differently.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@"
          }
        }
      }
    },
    "%@, %@, update available" : {
      "comment" : "Settings window, sidebar, row of one coding tool: VoiceOver label while a newer subspace version is published. The first argument is the tool's name, e.g. \"Claude Code\", the second its status, e.g. \"Connected · 1.0.1\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@, update available"
          }
        }
      }
    },
    "%@, %lld sessions" : {
      "comment" : "VoiceOver label of a tab in the popover's title bar without a tooltip: the Active tab while no session needs the user, the Idle tab while sessions never move there. The first argument is the tab's name (\"Active\" or \"Idle\"), the second the number of sessions the tab lists, e.g. \"Active, 2 sessions\". VoiceOver adds whether the tab is selected.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %#@sessions@"
          },
          "substitutions" : {
            "sessions" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg session"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg sessions"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@, %lld sessions, %@" : {
      "comment" : "VoiceOver label of the Idle or Finished tab in the popover's title bar. The first argument is the tab's name (\"Idle\" or \"Finished\"), the second the number of sessions the tab lists, the third the tab's tooltip, which sessions it holds, e.g. \"Idle, 2 sessions, Waiting over 5 min\" or \"Finished, 1 session, Cleared after 10 min\". VoiceOver adds whether the tab is selected.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %#@sessions@, %3$@"
          },
          "substitutions" : {
            "sessions" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg session"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg sessions"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@, %lld sessions, %lld need you" : {
      "comment" : "VoiceOver label of the Active tab in the popover's title bar while sessions need the user. The first argument is the tab's name (\"Active\"), the second the number of sessions the tab lists, the third the number of those in which anyone waits for the user, e.g. \"Active, 4 sessions, 2 need you\". VoiceOver adds whether the tab is selected.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %#@sessions@, %#@needYou@"
          },
          "substitutions" : {
            "needYou" : {
              "argNum" : 3,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg needs you"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg need you"
                    }
                  }
                }
              }
            },
            "sessions" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg session"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg sessions"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@, %lld sessions, unread, %@" : {
      "comment" : "VoiceOver label of the Idle or Finished tab in the popover's title bar while one of its sessions has a reply the user hasn't seen; the tab shows a dot after the count. The first argument is the tab's name (\"Idle\" or \"Finished\"), the second the number of sessions the tab lists, the third the tab's tooltip, which sessions it holds, e.g. \"Idle, 2 sessions, unread, Waiting over 5 min\" or \"Finished, 1 session, unread, Cleared after 10 min\". VoiceOver adds whether the tab is selected.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %#@sessions@, unread, %3$@"
          },
          "substitutions" : {
            "sessions" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg session"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg sessions"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@, choose any: %@" : {
      "comment" : "VoiceOver, row of a session asking a question: the question's short label, e.g. \"Mapping\", then the question. The user may pick several options.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, choose any: %@"
          }
        }
      }
    },
    "%@, choose one: %@" : {
      "comment" : "VoiceOver, row of a session asking a question: the question's short label, e.g. \"Mapping\", then the question. The user picks one option.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, choose one: %@"
          }
        }
      }
    },
    "%@, Default" : {
      "comment" : "VoiceOver, Appearance pane: a list row of the scheme used when the user picked none, or the value of its slot. The argument is the scheme's full name, e.g. \"Catppuccin Latte\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, Default"
          }
        }
      }
    },
    "A file with the same name already exists in the Themes folder. Replacing it will overwrite its current contents." : {
      "comment" : "Informative text of the alert that asks whether to replace a custom theme file of the same name in the Themes folder.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A file with the same name already exists in the Themes folder. Replacing it will overwrite its current contents."
          }
        }
      }
    },
    "Couldn’t import “%@”." : {
      "comment" : "Alert when a custom theme file could not be copied into the Themes folder. The argument is the file name, e.g. \"ocean.yaml\"; the system's reason follows below it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t import “%@”."
          }
        }
      }
    },
    "Custom" : {
      "comment" : "Settings window, Appearance pane: heading of the section of the user's own color schemes (custom themes from files) in the list under an open slot.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom"
          }
        }
      }
    },
    "Built-in" : {
      "comment" : "Settings window, Appearance pane: heading of the section of the color schemes that ship with the app, in the list under an open slot.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built-in"
          }
        }
      }
    },
    "Custom themes are base16 or base24 YAML files, like those from %@." : {
      "comment" : "Settings window, Appearance pane: footnote under the list of color schemes. base16 and base24 are file formats, never translated. The argument is the link \"tinted-theming ↗\" to the project's scheme collection.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom themes are base16 or base24 YAML files, like those from %@."
          }
        }
      }
    },
    "Import Theme…" : {
      "comment" : "Settings window, Appearance pane: button under the list of color schemes that opens the system's open panel to copy base16/base24 YAML theme files into the app's Themes folder.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import Theme…"
          }
        }
      }
    },
    "Light" : {
      "comment" : "Settings window, Appearance pane: header above the light color schemes in the list while one scheme is always used; light as opposed to dark.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light"
          }
        }
      }
    },
    "Dark" : {
      "comment" : "Settings window, Appearance pane: header above the dark color schemes in the list while one scheme is always used; dark as opposed to light.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dark"
          }
        }
      }
    },
    "Light Mode schemes" : {
      "comment" : "VoiceOver name of the area and list of color schemes under the slot \"Light Mode\" in the Appearance pane.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light Mode schemes"
          }
        }
      }
    },
    "Dark Mode schemes" : {
      "comment" : "VoiceOver name of the area and list of color schemes under the slot \"Dark Mode\" in the Appearance pane.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dark Mode schemes"
          }
        }
      }
    },
    "All schemes" : {
      "comment" : "VoiceOver name of the area and list of all color schemes under the slot \"Scheme\" in the Appearance pane, while one scheme is always used.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All schemes"
          }
        }
      }
    },
    "%@, custom themes" : {
      "comment" : "VoiceOver name of the section of the user's own color schemes in the Appearance pane's list. The argument is the slot's name, e.g. \"Dark Mode\" or \"Scheme\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, custom themes"
          }
        }
      }
    },
    "%@, built-in schemes" : {
      "comment" : "VoiceOver name of the section of the color schemes that ship with the app in the Appearance pane's list. The argument is the slot's name, e.g. \"Dark Mode\" or \"Scheme\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, built-in schemes"
          }
        }
      }
    },
    "Move to Trash" : {
      "comment" : "Settings window, Appearance pane: context menu item of a custom theme row that moves its file to the Trash without asking. Use macOS's own wording.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move to Trash"
          }
        }
      }
    },
    "No light schemes match “%@”." : {
      "comment" : "Settings window, Appearance pane: shown in place of the list of light color schemes when the search finds none. The argument is the search text as typed.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No light schemes match “%@”."
          }
        }
      }
    },
    "No dark schemes match “%@”." : {
      "comment" : "Settings window, Appearance pane: shown in place of the list of dark color schemes when the search finds none. The argument is the search text as typed.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No dark schemes match “%@”."
          }
        }
      }
    },
    "No schemes match “%@”." : {
      "comment" : "Settings window, Appearance pane: shown in place of the list of all color schemes, while one scheme is always used, when the search finds none. The argument is the search text as typed.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No schemes match “%@”."
          }
        }
      }
    },
    "%@, Default, in use" : {
      "comment" : "VoiceOver value of a slot (\"Light Mode\" or \"Dark Mode\") in the Appearance pane: its scheme is the one used when the user picked none, and macOS shows this mode right now. The argument is the scheme's full name, e.g. \"Catppuccin Latte\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, Default, in use"
          }
        }
      }
    },
    "%@, collapsed" : {
      "comment" : "VoiceOver value of a slot (\"Light Mode\", \"Dark Mode\" or \"Scheme\") in the Appearance pane while its list of color schemes is closed. The argument is the rest of the value, e.g. \"Catppuccin Latte, Default, in use\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, collapsed"
          }
        }
      }
    },
    "%@, expanded" : {
      "comment" : "VoiceOver value of a slot (\"Light Mode\", \"Dark Mode\" or \"Scheme\") in the Appearance pane while its list of color schemes is open under it. The argument is the rest of the value, e.g. \"Catppuccin Latte, Default, in use\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, expanded"
          }
        }
      }
    },
    "%@, in use" : {
      "comment" : "VoiceOver value of a slot (\"Light Mode\" or \"Dark Mode\") in the Appearance pane that macOS shows right now. The argument is the scheme's full name, e.g. \"Gruvbox Dark\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, in use"
          }
        }
      }
    },
    "%@, Light" : {
      "comment" : "VoiceOver label of a row in the Appearance pane's list of all color schemes, while one scheme is always used: the scheme is light. The argument is its name, e.g. \"Catppuccin Latte\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, Light"
          }
        }
      }
    },
    "%@, Dark" : {
      "comment" : "VoiceOver label of a row in the Appearance pane's list of all color schemes, while one scheme is always used: the scheme is dark. The argument is its name, e.g. \"Catppuccin Macchiato\".",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, Dark"
          }
        }
      }
    },
    "%@, custom, %@" : {
      "comment" : "VoiceOver label of a row for one of the user's own color schemes in the Appearance pane. The first argument is the scheme's name from its file, e.g. \"Horizon Dark\", the second its file name, e.g. \"horizon-dark.yaml\".",
      "localizations" : {
