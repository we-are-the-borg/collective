      }
    },
    "unread" : {
      "comment" : "Popover, VoiceOver: a session's row shows a dot after its name because its last turn ended with a reply the user hasn't seen. Read right after the row's status word, e.g. \"agent-collective, waiting for you, unread, 2 minutes\". Lowercase because it continues the label.",
      "localizations" : {
